@FaintAlertAPI_HostAddress = http://localhost:5043
@UserId = 00000000-0000-0000-0000-000000000001
@EmergencyContactId = 00000000-0000-0000-0000-000000000002




GET {{FaintAlertAPI_HostAddress}}/api/emergencycontacts

###

POST {{FaintAlertAPI_HostAddress}}/api/emergencycontacts
Content-Type: application/json

{
  "Name": "Mama",
  "Email": "mama@test.com",
  "Phone": "12345678",
  "UserId": "{{UserId}}"
}

###

DELETE {{FaintAlertAPI_HostAddress}}/api/emergencycontacts/{{EmergencyContactId}}

###

GET {{FaintAlertAPI_HostAddress}}/api/emergencycontacts/{{EmergencyContactId}}

###

PUT {{FaintAlertAPI_HostAddress}}/api/emergencycontacts/{{EmergencyContactId}}
Content-Type: application/json

{
  "Id": "{{EmergencyContactId}}",
  "Name": "Mama",
  "Email": "mama@test.com",
  "Phone": "12345678"
}

###

